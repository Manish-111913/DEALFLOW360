# Local development. Postgres runs in Docker on 5433 (5432 is taken by a local install).
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5433/dealflow360?schema=public"

# Auth.js — regenerate for any non-local environment: `npx auth secret`
AUTH_SECRET="generate-with-npx-auth-secret"
AUTH_URL="http://localhost:3000"

# Portal magic-link lifetime (minutes)
PORTAL_LINK_TTL_MINUTES="30"

# Test database. Dropped and rebuilt on every `npm test` run.
TEST_DATABASE_URL="postgresql://USER:PASSWORD@localhost:5433/dealflow360_test?schema=public"

# Password hashing cost. Operational, not business config.
# Lower it in CI for speed; leave unset for the default of 12.
BCRYPT_COST="12"

# Password recovery link lifetime (minutes). Default 15.
PASSWORD_RESET_TTL_MINUTES=15

# --- Google Workspace sign-in -------------------------------------------
# Both required, or the provider is not registered and the button is disabled.
# Redirect URI to register: http://localhost:3001/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Domains allowed to self-provision. Empty = existing accounts only.
GOOGLE_ALLOWED_DOMAINS=
# Role for a self-provisioned Google user. Default SALES_REP.
GOOGLE_DEFAULT_ROLE=SALES_REP
