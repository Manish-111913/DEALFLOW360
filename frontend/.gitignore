# @dealflow/frontend
#
# Patterns here are relative to this folder. The root .gitignore uses
# leading-slash patterns (/node_modules, /.next), which anchor to the repo root
# and therefore never reach into a workspace.

# dependencies
/node_modules

# next.js
#
# Each surface builds into its own directory - `next dev` locks the one it is
# using and refuses a second server sharing it, so the internal workspace and
# the customer portal need separate ones to run at the same time. The glob
# covers all of them; `/.next/` alone left several hundred generated files
# showing up as untracked changes.
/.next/
/.next-*/
/out/
/build

# regenerated by next dev / next build
next-env.d.ts

# vercel
/.vercel

*.tsbuildinfo
