DealFlow360_Documentation/

# --- Next.js ---
# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# generated Prisma client
/src/generated

# build artifacts / tool droppings
*.tsbuildinfo
.agents/
.windsurf/
skills-lock.json

# .env* above also swallows the template. Real secrets stay ignored; this one
# is committed on purpose — the README tells people to copy it.
!.env.example

# Google OAuth client downloads. The values belong in .env (which is ignored
# above); the file Google hands you is a live credential and must never be
# committed, so it is ignored by shape rather than by name.
client_secret_*.json
