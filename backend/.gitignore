# @dealflow/backend
#
# Patterns here are relative to this folder. The root .gitignore uses
# leading-slash patterns (/node_modules, /.next), which anchor to the repo root
# and therefore never reach into a workspace.

# dependencies
/node_modules

# Prisma client — regenerated by `npm run db:generate`, never committed
/src/generated

# test and build artifacts
/coverage
*.tsbuildinfo
